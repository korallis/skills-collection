#!/usr/bin/env python3
"""Discover which models the current user can actually reach.

Harness first, vendor CLIs only as a fallback. Writes one routes file that every
skill reads, so no skill has to guess what is installed.

    agent-routes scan     probe everything and write the routes file
    agent-routes show     print the current routes file
    agent-routes where    print the routes file path

Adding a harness or a CLI means adding one PROBES entry. Nothing else changes.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Callable, Iterable

SCHEMA_VERSION = 1
DEFAULT_TIMEOUT = 25


def routes_path() -> Path:
    override = os.environ.get("AGENT_ROUTES_FILE")
    if override:
        return Path(override).expanduser()
    root = os.environ.get("AGENT_SKILLS_HOME")
    base = Path(root).expanduser() if root else Path.home() / ".agents"
    return base / "routes.json"


# --------------------------------------------------------------------------
# Model family
# --------------------------------------------------------------------------

# Ordered: the first pattern that matches wins. Verified against first-party
# vendor docs on 2026-08-28; see lee-engineering/references/model-facts.md.
#
# `grok` precedes `composer` because xAI serves `grok-composer-*`, which is Grok
# lineage. Cursor's bare `composer-*` is its own line, built on a Kimi
# checkpoint by Cursor's own account, so it is neither GPT nor Kimi here.
FAMILY_PATTERNS: tuple[tuple[str, str], ...] = (
    (r"claude|sonnet|opus|haiku|fable|mythos", "claude"),
    (r"gemini", "gemini"),
    (r"grok", "grok"),
    (r"composer", "composer"),
    (r"kimi|moonshot", "kimi"),
    (r"\bglm", "glm"),
    (r"deepseek", "deepseek"),
    (r"qwen", "qwen"),
    # Meta ships two lines: Llama and the newer Muse.
    (r"llama|behemoth|maverick", "llama"),
    (r"\bmuse[-_]|glimmer", "muse"),
    # Mistral's small line is `ministral`, which does NOT contain "mistral", and
    # its specialist models share the `-stral` suffix.
    (r"mistral|ministral|codestral|devstral|voxtral|leanstral|shieldstral|\w+stral", "mistral"),
    (r"minimax", "minimax"),
    (r"gpt|codex|daybreak|(^|/)o[1345](-|$|\b)|davinci", "gpt"),
)


def family_of(model_id: str) -> str:
    """Derive lineage from the model ID. Never from the harness or CLI name."""
    lowered = model_id.lower()
    for pattern, family in FAMILY_PATTERNS:
        if re.search(pattern, lowered):
            return family
    return "unknown"


# --------------------------------------------------------------------------
# Shell
# --------------------------------------------------------------------------


def run(command: list[str], timeout: int = DEFAULT_TIMEOUT) -> tuple[int, str]:
    try:
        completed = subprocess.run(
            command,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return 124, f"timed out after {timeout}s"
    except OSError as error:
        # Which errno a missing binary raises is platform-dependent: macOS can
        # report EACCES where Linux reports ENOENT. Ask the resolver instead.
        if shutil.which(command[0]) is None:
            return 127, "not installed"
        return 1, str(error)
    return completed.returncode, completed.stdout if completed.returncode == 0 else (
        completed.stderr or completed.stdout
    )


def installed(binary: str) -> bool:
    return shutil.which(binary) is not None


# --------------------------------------------------------------------------
# Probes
#
# A probe returns (routes, pools, note). It must never raise: an unreachable
# source is a recorded fact, not a crash.
# --------------------------------------------------------------------------


def probe_omp(source: str) -> tuple[list[dict], list[dict], str | None]:
    code, output = run(["omp", "models", "--json"])
    if code != 0:
        return [], [], f"catalog failed: {output.strip()[:200]}"

    try:
        entries = json.loads(output).get("models", [])
    except json.JSONDecodeError as error:
        return [], [], f"catalog was not JSON: {error}"

    routes = []
    for entry in entries:
        model_id = entry.get("id", "")
        provider = entry.get("provider", "")
        routes.append(
            {
                "source": source,
                "sourceKind": "harness",
                "provider": provider,
                "selector": entry.get("selector") or f"{provider}/{model_id}",
                "modelId": model_id,
                "family": family_of(model_id),
                "pool": f"{source}:{provider}",
                "contextWindow": entry.get("contextWindow"),
                "maxOutput": entry.get("maxTokens"),
                "reasoning": entry.get("reasoning"),
                "thinkingLevels": entry.get("thinking"),
                "cost": entry.get("cost"),
                "discoveredBy": "omp models --json",
            }
        )

    pools, note = _omp_pools(source)
    return routes, pools, note


def _omp_pools(source: str) -> tuple[list[dict], str | None]:
    code, output = run(["omp", "usage", "--json", "--redact"])
    if code != 0:
        return [], f"usage unavailable, pools unknown: {output.strip()[:120]}"

    try:
        report = json.loads(output)
    except json.JSONDecodeError as error:
        return [], f"usage was not JSON: {error}"

    unusable = set(report.get("accountsWithoutUsage") or []) | set(
        report.get("disabledCredentials") or []
    )

    pools = []
    for provider, windows in (report.get("capacity") or {}).items():
        for window in windows:
            used = window.get("usedAccounts")
            pools.append(
                {
                    "poolId": f"{source}:{provider}",
                    "source": source,
                    "provider": provider,
                    "meter": window.get("meter"),
                    "window": window.get("window"),
                    "usedFraction": used,
                    "remainingFraction": window.get("remainingAccounts"),
                    # The report gives a window LENGTH, not when this window
                    # started, so a reset time cannot honestly be derived.
                    "windowDurationMs": window.get("durationMs"),
                    "resetsAt": None,
                    "state": "blocked" if provider in unusable else _pool_state(used),
                }
            )

    # One poolId can carry several windows. A route drawing on it is limited by
    # the worst of them, so every row reports that rollup alongside its own
    # window state. Otherwise a 7d-available row hides a 5h-exhausted sibling.
    for pool in pools:
        siblings = [other for other in pools if other["poolId"] == pool["poolId"]]
        pool["poolState"] = max(
            (sibling["state"] for sibling in siblings), key=lambda state: POOL_SEVERITY[state]
        )
    return pools, None


POOL_SEVERITY = {"available": 0, "unknown": 1, "constrained": 2, "exhausted": 3, "blocked": 4}


def _pool_state(used_fraction: Any) -> str:
    if not isinstance(used_fraction, (int, float)):
        return "unknown"
    if used_fraction >= 1:
        return "exhausted"
    if used_fraction >= 0.85:
        return "constrained"
    return "available"


def _text_catalog(
    source: str,
    command: list[str],
    parse: Callable[[str], Iterable[str]],
    provider: str,
) -> tuple[list[dict], list[dict], str | None]:
    """Shared shape for CLIs that list models as plain text."""
    code, output = run(command)
    if code != 0:
        return [], [], f"{' '.join(command)} failed: {output.strip()[:200]}"
    if _looks_like_error(output):
        return [], [], f"{' '.join(command)} returned an error on stdout"

    routes = [
        {
            "source": source,
            "sourceKind": "cli-fallback",
            "provider": provider,
            "selector": model_id,
            "modelId": model_id,
            "family": family_of(model_id),
            "pool": f"{source}:{provider}",
            "contextWindow": None,
            "maxOutput": None,
            "reasoning": None,
            "thinkingLevels": None,
            "cost": None,
            "discoveredBy": " ".join(command),
        }
        for model_id in parse(output)
    ]
    # No CLI here exposes a machine-readable account meter, so the pool is
    # recorded unknown rather than guessed.
    pool = [
        {
            "poolId": f"{source}:{provider}",
            "source": source,
            "provider": provider,
            "meter": None,
            "window": None,
            "usedFraction": None,
            "remainingFraction": None,
            "resetsAt": None,
            "state": "unknown",
        }
    ]
    return routes, (pool if routes else []), "text catalog; quota not machine-readable"


# A parsed token must look like a model id, not like prose. Inventing a route
# named "Error" or "Models" is far worse than returning none: the agent will
# dispatch to it.
MODEL_ID = re.compile(r"^[A-Za-z0-9][\w.\-]*(?:/[A-Za-z0-9][\w.\-]*)?$")
NOT_MODELS = {
    "auto", "default", "error", "models", "model", "available", "usage",
    "authentication", "unauthorized", "forbidden", "warning", "info", "none",
}
ERROR_MARKERS = (
    "not authenticated", "authentication failed", "unauthorized", "please log in",
    "login required", "no api key", "rate limit", "error:",
)


def _looks_like_error(output: str) -> bool:
    lowered = output.lower()
    return any(marker in lowered for marker in ERROR_MARKERS)


def _accept(token: str) -> bool:
    """Require a model-shaped token that carries a digit.

    Every current vendor model id is versioned, so the digit requirement drops
    prose like `Authentication` while keeping `grok-4.6` and `claude-opus-5`.
    """
    if token.lower() in NOT_MODELS or not MODEL_ID.match(token):
        return False
    return any(character.isdigit() for character in token)


def _parse_cursor(output: str) -> list[str]:
    return [
        match.group(1)
        for line in output.splitlines()
        if (match := re.match(r"^\s*(\S+)\s+-\s+\S", line)) and _accept(match.group(1))
    ]


def _parse_grok(output: str) -> list[str]:
    return [
        match.group(1)
        for line in output.splitlines()
        if (match := re.match(r"^\s*[*\-]\s+(\S+)", line)) and _accept(match.group(1))
    ]


def probe_cursor(source: str) -> tuple[list[dict], list[dict], str | None]:
    return _text_catalog(source, ["cursor-agent", "models"], _parse_cursor, "cursor")


def probe_grok(source: str) -> tuple[list[dict], list[dict], str | None]:
    return _text_catalog(source, ["grok", "models"], _parse_grok, "xai")


def probe_t3(source: str) -> tuple[list[dict], list[dict], str | None]:
    """T3 publishes its entitled models as a file, so no subprocess is needed.

    `~/.t3/userdata/model-manifest.json` holds `manifest.currentModels`, keyed
    by backend, each a list of model ids the account may use.
    """
    manifest = Path.home() / ".t3" / "userdata" / "model-manifest.json"
    if not manifest.is_file():
        return [], [], "no model manifest at ~/.t3/userdata/model-manifest.json"
    try:
        current = json.loads(manifest.read_text(encoding="utf-8"))["manifest"]["currentModels"]
    except (json.JSONDecodeError, KeyError, TypeError, OSError) as error:
        return [], [], f"model manifest unreadable: {error}"
    if not isinstance(current, dict):
        return [], [], f"model manifest currentModels is {type(current).__name__}, not a map"

    routes = []
    pools = []
    for backend, models in current.items():
        if not isinstance(models, list):
            continue
        pools.append(
            {
                "poolId": f"{source}:{backend}",
                "source": source,
                "provider": backend,
                "meter": None,
                "window": None,
                "usedFraction": None,
                "remainingFraction": None,
                "windowDurationMs": None,
                "resetsAt": None,
                "state": "unknown",
            }
        )
        routes.extend(
            {
                "source": source,
                "sourceKind": "cli-fallback",
                "provider": backend,
                "selector": f"{backend}/{model_id}",
                "modelId": model_id,
                "family": family_of(model_id),
                "pool": f"{source}:{backend}",
                "contextWindow": None,
                "maxOutput": None,
                "reasoning": None,
                "thinkingLevels": None,
                "cost": None,
                "discoveredBy": "~/.t3/userdata/model-manifest.json",
            }
            for model_id in models
            if isinstance(model_id, str) and model_id
        )
    for pool in pools:
        pool["poolState"] = pool["state"]
    return routes, pools, "manifest catalog; quota not machine-readable"


# ------------------------------------------------------------------
# Authentication
#
# An installed CLI is not a usable route. A logged-out CLI can still print a
# model table, or an error that parses as one, so every CLI source must prove it
# is authenticated before its routes count. The harness needs no separate check:
# its catalog is credential-scoped, so listing models IS the proof.
# ------------------------------------------------------------------


def auth_by_command(command: list[str]) -> Callable[[], tuple[bool, str]]:
    def check() -> tuple[bool, str]:
        code, output = run(command, timeout=20)
        if code == 0:
            return True, output.strip().splitlines()[0][:80] if output.strip() else "authenticated"
        return False, f"{' '.join(command)} says not signed in"

    return check


def auth_claude() -> tuple[bool, str]:
    """`claude auth status` returns JSON and exits 0 either way, so read it."""
    code, output = run(["claude", "auth", "status"], timeout=20)
    if code != 0:
        return False, "claude auth status failed"
    try:
        report = json.loads(output)
    except json.JSONDecodeError:
        return False, "claude auth status was not JSON"
    if report.get("loggedIn") is True:
        return True, f"signed in via {report.get('authMethod', 'unknown method')}"
    return False, "claude auth status reports not signed in"


def auth_unverifiable(reason: str) -> Callable[[], tuple[bool, str]]:
    """No documented non-interactive way to prove this CLI is signed in.

    Excluded rather than assumed: admitting an unauthenticated CLI produces
    routes that fail at dispatch.
    """

    def check() -> tuple[bool, str]:
        return False, reason

    return check


def auth_grok() -> tuple[bool, str]:
    """Grok has no status subcommand; its model list states the account."""
    code, output = run(["grok", "models"], timeout=20)
    if code != 0:
        return False, "grok models failed"
    for line in output.splitlines():
        if "logged in" in line.lower():
            return True, line.strip()[:80]
    return False, "grok models did not report a signed-in account"


def auth_t3() -> tuple[bool, str]:
    """T3 keeps a session token beside its manifest."""
    userdata = Path.home() / ".t3" / "userdata"
    token = userdata / "clerk-tokens.json"
    if not token.is_file():
        return False, "no T3 session token in ~/.t3/userdata"
    return True, "T3 session token present"


def auth_always() -> tuple[bool, str]:
    return True, "credential-scoped catalog"


def probe_none(source: str) -> tuple[list[dict], list[dict], str | None]:
    """This harness or CLI publishes no model list.

    That is a fact about the tool, not evidence the account has no models. When
    this is the CURRENT harness, scan() adds a live-session route so the session
    can still name the model it is already talking to.
    """
    return [], [], "publishes no machine-readable model list"


PROBES: tuple[dict[str, Any], ...] = (
    {
        "id": "omp",
        "auth": auth_always,
        "binary": "omp",
        "harnessEnv": ("OMPCODE", "OMP_SESSION_ID", "PI_SESSION_ID"),
        "versionArgs": ["--version"],
        "probe": probe_omp,
    },
    {
        "id": "claude-code",
        "auth": auth_claude,
        "binary": "claude",
        "harnessEnv": ("CLAUDECODE", "CLAUDE_CODE_SESSION_ID"),
        "versionArgs": ["--version"],
        "probe": probe_none,
    },
    {
        "id": "cursor",
        "auth": auth_by_command(["cursor-agent", "status"]),
        "binary": "cursor-agent",
        "harnessEnv": ("CURSOR_AGENT", "CURSOR_TRACE_ID"),
        "versionArgs": ["--version"],
        "probe": probe_cursor,
    },
    {
        "id": "grok",
        "auth": auth_grok,
        "binary": "grok",
        "harnessEnv": ("GROK_SESSION_ID",),
        "versionArgs": ["--version"],
        "probe": probe_grok,
    },
    {
        "id": "codex",
        "auth": auth_by_command(["codex", "login", "status"]),
        "binary": "codex",
        "harnessEnv": ("CODEX_SANDBOX", "CODEX_THREAD_ID"),
        "versionArgs": ["--version"],
        "probe": probe_none,
    },
    {
        "id": "gemini",
        "auth": auth_unverifiable("no documented non-interactive auth check"),
        "binary": "gemini",
        "harnessEnv": ("GEMINI_CLI", "GEMINI_SESSION_ID"),
        "versionArgs": ["--version"],
        "probe": probe_none,
    },
    {
        "id": "t3",
        "auth": auth_t3,
        "binary": "t3",
        "harnessEnv": ("T3_SESSION_ID", "T3_ENVIRONMENT_ID"),
        "versionArgs": ["--version"],
        "probe": probe_t3,
        "fileBacked": True,
    },
    {
        "id": "opencode",
        "auth": auth_unverifiable("no documented non-interactive auth check"),
        "binary": "opencode",
        "harnessEnv": ("OPENCODE_CLIENT", "OPENCODE_SESSION_ID"),
        "versionArgs": ["--version"],
        "probe": probe_none,
    },
)


# --------------------------------------------------------------------------
# Harness detection
# --------------------------------------------------------------------------


def detect_harness() -> dict[str, Any]:
    """Identify the harness running this process.

    Env wins over an installed binary: several harnesses ship compatibility
    variables for each other, so PROBES order breaks the tie. omp sets both
    OMPCODE and CLAUDECODE, and is listed first for exactly that reason.
    """
    for probe in PROBES:
        for variable in probe["harnessEnv"]:
            if os.environ.get(variable):
                return {
                    "id": probe["id"],
                    "version": version_of(probe),
                    "detectedBy": f"{variable} environment variable",
                }
    return {"id": "unknown", "version": None, "detectedBy": "no harness marker found"}


def version_of(probe: dict[str, Any]) -> str | None:
    if not installed(probe["binary"]):
        return None
    code, output = run([probe["binary"], *probe["versionArgs"]], timeout=10)
    return output.strip().splitlines()[0] if code == 0 and output.strip() else None


# --------------------------------------------------------------------------
# Scan
# --------------------------------------------------------------------------


def _source_status(found: list[dict], note: str | None) -> str:
    """Distinguish "no models here" from "this failed". An agent must not read
    a failure as an absence."""
    if found:
        return "ok"
    if not note:
        return "empty"
    if "publishes no machine-readable model list" in note:
        return "no-api"
    if "timed out" in note:
        return "timeout"
    return "failed"


def _live_session_route(
    harness: dict[str, Any], routes: list[dict], versions: dict[str, str | None]
) -> list[dict]:
    """The model you are already talking to is a route.

    Claude Code, Codex, Gemini CLI and opencode publish no model list, so
    without this the scan reports zero harness routes while a model is
    demonstrably working, and every vendor CLI then looks like the only way to
    reach its family. The session's own model is unnamed, so it is recorded
    `family: unknown`: usable for work, never sufficient for a review gate that
    needs a different family.
    """
    identifier = harness["id"]
    if identifier == "unknown":
        return []
    if any(route["sourceKind"] == "harness" for route in routes):
        return []
    return [
        {
            "source": identifier,
            "sourceKind": "harness",
            "provider": identifier,
            "selector": "<live session>",
            "modelId": "unknown",
            "family": "unknown",
            "pool": f"{identifier}:live-session",
            "contextWindow": None,
            "maxOutput": None,
            "reasoning": None,
            "thinkingLevels": None,
            "cost": None,
            "discoveredBy": f"{identifier} session detected via {harness['detectedBy']}",
            "note": (
                "the model this session already runs on; this harness publishes no "
                "model list, so its identity is unknown. Keep working here rather "
                "than leaving for a CLI."
            ),
        }
    ]


def scan() -> dict[str, Any]:
    harness = detect_harness()
    sources: list[dict] = []
    routes: list[dict] = []
    pools: list[dict] = []
    versions: dict[str, str | None] = {}

    for probe in PROBES:
        is_current = probe["id"] == harness["id"]
        if not installed(probe["binary"]) and not probe.get("fileBacked"):
            if is_current:
                sources.append(
                    {
                        "id": probe["id"],
                        "kind": "harness",
                        "status": "unavailable",
                        "routes": 0,
                        "note": "current harness, but its binary is not on PATH",
                    }
                )
            continue

        kind = "harness" if is_current else "cli-fallback"

        # A CLI must prove it is signed in before its models count as routes.
        signed_in, auth_note = probe["auth"]()
        if not signed_in:
            versions[probe["id"]] = version_of(probe)
            sources.append(
                {
                    "id": probe["id"],
                    "kind": kind,
                    "status": "unauthenticated",
                    "version": versions[probe["id"]],
                    "routes": 0,
                    "note": auth_note,
                }
            )
            continue

        found, found_pools, note = probe["probe"](probe["id"])
        for route in found:
            route["sourceKind"] = kind
        for pool in found_pools:
            pool["kind"] = kind

        versions[probe["id"]] = version_of(probe)
        sources.append(
            {
                "id": probe["id"],
                "kind": kind,
                "status": _source_status(found, note),
                "version": versions[probe["id"]],
                "routes": len(found),
                "note": note,
            }
        )
        routes.extend(found)
        pools.extend(found_pools)

    routes.extend(_live_session_route(harness, routes, versions))
    _mark_fallbacks(routes)
    _mark_harness_sufficiency(routes)
    routes.sort(
        key=lambda route: (route["sourceKind"] != "harness", route["source"], route["selector"])
    )

    for index, route in enumerate(routes, start=1):
        route["routeId"] = f"r{index:03d}"

    return {
        "schemaVersion": SCHEMA_VERSION,
        "scannedAt": datetime.now(timezone.utc).isoformat(),
        "harness": harness,
        "sources": sources,
        "routes": routes,
        "pools": pools,
        "families": _families(routes),
        "harnessSufficient": bool(routes) and routes[0].get("harnessSufficient", False),
    }


def _mark_fallbacks(routes: list[dict]) -> None:
    """A CLI route is redundant when the harness already reaches that family.

    This is what makes CLIs a fallback rather than a peer: reaching the same
    family through a second process adds a data route and a second draw on a
    meter without adding capability.
    """
    in_harness = {
        route["family"] for route in routes if route["sourceKind"] == "harness"
    }
    for route in routes:
        if route["sourceKind"] != "cli-fallback":
            route["preferOver"] = None
            continue
        route["preferOver"] = (
            "harness already reaches this family; use the CLI only for a capability "
            "the harness cannot provide"
            if route["family"] in in_harness
            else None
        )


def _mark_harness_sufficiency(routes: list[dict]) -> None:
    """Record whether the harness alone covers an independent-review gate.

    When the current harness reaches two or more identifiable families it can
    author and review on its own, so a CLI adds nothing but a second data route
    and a hidden draw on someone else's meter. `agent-roles` reads this to skip
    CLI routes entirely in that case.
    """
    harness_families = {
        route["family"]
        for route in routes
        if route["sourceKind"] == "harness" and route["family"] != "unknown"
    }
    sufficient = len(harness_families) >= 2
    for route in routes:
        route["harnessSufficient"] = sufficient


def _families(routes: list[dict]) -> dict[str, dict[str, list[str]]]:
    summary: dict[str, dict[str, list[str]]] = {}
    for route in routes:
        entry = summary.setdefault(route["family"], {"harness": [], "fallback": []})
        bucket = "harness" if route["sourceKind"] == "harness" else "fallback"
        if route["pool"] not in entry[bucket]:
            entry[bucket].append(route["pool"])
    return summary


# --------------------------------------------------------------------------
# Presentation
# --------------------------------------------------------------------------


def summarise(report: dict[str, Any]) -> str:
    lines = [
        f"harness    {report['harness']['id']} "
        f"({report['harness'].get('version') or 'version unknown'})",
        f"scanned    {report['scannedAt']}",
        "",
        "sources",
    ]
    for source in report["sources"]:
        note = f"  {source['note']}" if source.get("note") else ""
        lines.append(
            f"  {source['id']:<12} {source['kind']:<13} {source['status']:<12}"
            f" {source.get('routes', 0):>4} routes{note}"
        )

    lines += ["", "families                harness pools / fallback pools"]
    for family, pools in sorted(report["families"].items()):
        lines.append(
            f"  {family:<12} {', '.join(pools['harness']) or '-':<34}"
            f" {', '.join(pools['fallback']) or '-'}"
        )

    metered = [pool for pool in report["pools"] if pool.get("usedFraction") is not None]
    if metered:
        lines += ["", "pools"]
        for pool in metered:
            lines.append(
                f"  {pool['poolId']:<22} {str(pool.get('meter') or '-'):<22}"
                f" {pool.get('window') or '-':<8}"
                f" {pool['usedFraction'] * 100:5.1f}% used  {pool['state']}"
            )

    unknown = [pool for pool in report["pools"] if pool.get("usedFraction") is None]
    if unknown:
        lines.append("")
        lines.append(
            "  unmetered pools (schedule one small packet, then re-check): "
            + ", ".join(sorted({pool["poolId"] for pool in unknown}))
        )
    return "\n".join(lines)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("action", choices=("scan", "show", "where"), nargs="?", default="scan")
    parser.add_argument("--json", action="store_true", help="emit JSON instead of a summary")
    arguments = parser.parse_args(argv)

    target = routes_path()

    if arguments.action == "where":
        print(target)
        return 0

    if arguments.action == "show":
        if not target.is_file():
            print(f"no routes file at {target}; run: agent-routes scan", file=sys.stderr)
            return 1
        report = json.loads(target.read_text(encoding="utf-8"))
    else:
        report = scan()
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    print(json.dumps(report, indent=2, sort_keys=True) if arguments.json else summarise(report))
    if arguments.action == "scan" and not arguments.json:
        print(f"\nwritten to {target}")
    return 0 if report["routes"] else 1


if __name__ == "__main__":
    sys.exit(main())
