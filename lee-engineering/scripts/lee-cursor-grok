#!/bin/sh
set -eu

for argument in "$@"; do
  case "$argument" in
    --force | --force=* | --yolo | --yolo=* | --auto-review | --auto-review=* | \
      --plan | --plan=* | --mode | --mode=* | --model | --model=* | -m | -m*)
      echo "lee-cursor-grok: approve mode is fixed and the model is pinned by this wrapper; remove '$argument'" >&2
      exit 64
      ;;
  esac
done

if [ -z "${LEE_CURSOR_GROK_MODEL:-}" ]; then
  echo "lee-cursor-grok: set LEE_CURSOR_GROK_MODEL to a selector from your scan" >&2
  echo "  (run bin/agent-routes scan, or read ~/.agents/routing.md)" >&2
  exit 64
fi

exec cursor-agent --force --model "$LEE_CURSOR_GROK_MODEL" "$@"
